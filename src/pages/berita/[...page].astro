---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getPublishedNews, type NewsEntry } from "../../lib/news";
import { buildCompanyOptions, type CompanyOption } from "../../lib/news-search";
import { withBase } from "../../lib/url";

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getPublishedNews();
  const companies = buildCompanyOptions(articles.map((article) => article.data.company));
  return paginate(articles, { pageSize: 9, props: { companies } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<NewsEntry>;
  companies: CompanyOption[];
}

const { page, companies } = Astro.props;
const articles = page.data;

const totalPages = page.lastPage;
const current = page.currentPage;

/**
 * Windowed page list: always show first, last, and current ±1.
 * Gaps are collapsed into "…" so the bar never overflows on mobile,
 * e.g. 1 … 4 5 6 … 20
 */
function buildPageItems(cur: number, last: number): (number | "gap")[] {
  const keep = new Set<number>([1, last, cur - 1, cur, cur + 1]);
  const nums = [...keep].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  const items: (number | "gap")[] = [];
  nums.forEach((n, i) => {
    const prev = nums[i - 1];
    if (prev !== undefined && n - prev > 1) {
      // Single hidden page? show it instead of an ellipsis.
      if (n - prev === 2) items.push(prev + 1);
      else items.push("gap");
    }
    items.push(n);
  });
  return items;
}

const pageItems = buildPageItems(current, totalPages);

function getPageUrl(num: number): string {
  return num === 1 ? withBase("/berita") : withBase(`/berita/${num}`);
}
---

<BaseLayout
  title={page.currentPage === 1 ? "Berita" : `Berita — Halaman ${page.currentPage}`}
  description="Daftar berita AI ringkas dari rilis industri — Sinyal AI."
>
  <section class="container reveal reveal-1">
    <header class="archive-header">
      <p class="eyebrow">Archive</p>
      <h1 class="page-title">Semua berita</h1>
      <p class="page-lead">
        Kumpulan sinyal yang dirangkum dari blog, changelog, dan rilis resmi
        perusahaan AI. Disimpan sebagai Markdown content collections.
      </p>
      {
        page.total > 0 && (
          <form
            class="news-toolbar"
            role="search"
            aria-label="Cari dan saring berita"
            data-news-search
            data-index-url={withBase("/berita/search-index.json")}
            hidden
          >
            <div class="field field-search">
              <label class="visually-hidden" for="news-q">
                Cari berita
              </label>
              <svg
                class="field-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <input
                id="news-q"
                name="q"
                type="search"
                placeholder="Cari berita, mis. Claude atau agen"
                autocomplete="off"
                enterkeyhint="search"
              />
            </div>
            <div class="field field-company">
              <label class="visually-hidden" for="news-company">
                Saring berdasarkan perusahaan
              </label>
              <select id="news-company" name="perusahaan">
                <option value="">Semua perusahaan</option>
                {companies.map((company) => (
                  <option value={company.name}>
                    {company.name} ({company.count})
                  </option>
                ))}
              </select>
              <svg
                class="field-caret"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
            <button type="submit" class="btn btn-primary toolbar-btn">
              Cari
            </button>
            <button type="button" class="btn btn-ghost toolbar-btn" data-reset hidden>
              Reset
            </button>
          </form>
        )
      }

      <p class="search-status" role="status" aria-live="polite" data-search-status hidden></p>

      <div class="archive-meta" data-browse>
        <span class="count-tag">
          {page.total === 0
            ? "Belum ada sinyal terbit"
            : `Menampilkan ${page.start + 1}–${page.end + 1} dari ${page.total} sinyal resmi`}
        </span>
        <span class="page-indicator">
          Halaman {page.currentPage} dari {page.lastPage}
        </span>
      </div>
    </header>

    <div class="news-grid" data-search-results hidden></div>

    {articles.length > 0 && (
      <template data-card-template>
        <NewsCard article={articles[0]} />
      </template>
    )}

    <div data-browse>
    {
      articles.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">Feed masih kosong</p>
          <p>
            Buat file baru di <code>src/content/news/</code> dengan frontmatter
            yang valid.
          </p>
        </div>
      ) : (
        <div class="news-grid">
          {articles.map((article, idx) => (
            <NewsCard article={article} index={idx} />
          ))}
        </div>
      )
    }

    {
      totalPages > 1 && (
        <nav class="pagination" aria-label="Navigasi halaman berita">
          {page.url.prev ? (
            <a class="page-btn page-prev" href={page.url.prev} rel="prev">
              <span aria-hidden="true">←</span> Sebelumnya
            </a>
          ) : (
            <span class="page-btn page-disabled" aria-disabled="true">
              <span aria-hidden="true">←</span> Sebelumnya
            </span>
          )}

          <div class="page-numbers">
            {pageItems.map((num) => {
              if (num === "gap") {
                return <span class="page-gap" aria-hidden="true">…</span>;
              }
              const isCurrent = num === current;
              return isCurrent ? (
                <span class="page-num active" aria-current="page">
                  {num}
                </span>
              ) : (
                <a class="page-num" href={getPageUrl(num)} aria-label={`Halaman ${num}`}>
                  {num}
                </a>
              );
            })}
          </div>

          {page.url.next ? (
            <a class="page-btn page-next" href={page.url.next} rel="next">
              Selanjutnya <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="page-btn page-disabled" aria-disabled="true">
              Selanjutnya <span aria-hidden="true">→</span>
            </span>
          )}
        </nav>
      )
    }
    </div>
  </section>
</BaseLayout>

<script>
  import { filterEntries, type SearchEntry } from "../../lib/news-search";

  const CARD_DELAY_STEP_MS = 45;
  const CARD_DELAY_MAX_MS = 360;
  const TYPING_DEBOUNCE_MS = 180;

  let indexPromise: Promise<SearchEntry[]> | null = null;

  function loadIndex(url: string): Promise<SearchEntry[]> {
    if (!indexPromise) {
      indexPromise = fetch(url)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json() as Promise<SearchEntry[]>;
        })
        .catch((error) => {
          indexPromise = null;
          throw error;
        });
    }
    return indexPromise;
  }

  function initNewsSearch() {
    const form = document.querySelector<HTMLFormElement>("[data-news-search]");
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    const select = form.querySelector<HTMLSelectElement>('select[name="perusahaan"]');
    const resetButton = form.querySelector<HTMLButtonElement>("[data-reset]");
    const status = document.querySelector<HTMLElement>("[data-search-status]");
    const results = document.querySelector<HTMLElement>("[data-search-results]");
    const template = document.querySelector<HTMLTemplateElement>("[data-card-template]");
    const browseBlocks = document.querySelectorAll<HTMLElement>("[data-browse]");
    const indexUrl = form.dataset.indexUrl;
    if (!input || !select || !resetButton || !status || !results || !template || !indexUrl) return;

    // Pencarian butuh JavaScript; tanpa itu pembaca tetap bisa menelusuri halaman bernomor.
    form.hidden = false;

    let debounceTimer: number | undefined;
    let runId = 0;

    const setBrowseMode = (browsing: boolean) => {
      browseBlocks.forEach((block) => {
        block.hidden = !browsing;
      });
      results.hidden = browsing;
      status.hidden = browsing;
      resetButton.hidden = browsing;
    };

    const syncUrl = (query: string, company: string) => {
      const params = new URLSearchParams();
      if (query) params.set("q", query);
      if (company) params.set("perusahaan", company);
      const search = params.toString();
      const url = `${window.location.pathname}${search ? `?${search}` : ""}${window.location.hash}`;
      window.history.replaceState(window.history.state, "", url);
    };

    const describe = (count: number, query: string, company: string) => {
      const subject = count === 0 ? "Tidak ada berita yang cocok" : `Menampilkan ${count} berita`;
      const parts = [subject];
      if (query) parts.push(`untuk “${query}”`);
      if (company) parts.push(`dari ${company}`);
      return parts.join(" ");
    };

    const renderCard = (entry: SearchEntry, position: number): Node | null => {
      const card = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
      if (!card) return null;
      const set = (selector: string, apply: (el: HTMLElement) => void) => {
        const el = card.querySelector<HTMLElement>(selector);
        if (el) apply(el);
      };
      set(".tag", (el) => (el.textContent = entry.company));
      set(".date", (el) => {
        el.textContent = entry.dateLabel;
        el.setAttribute("datetime", entry.date);
      });
      set(".card-title a", (el) => {
        el.textContent = entry.title;
        el.setAttribute("href", entry.href);
      });
      set(".card-summary", (el) => (el.textContent = entry.summary));
      set(".card-link", (el) => {
        el.setAttribute("href", entry.href);
        el.setAttribute("aria-label", `Baca sinyal: ${entry.title}`);
      });
      card.style.setProperty("--card-delay", `${Math.min(position * CARD_DELAY_STEP_MS, CARD_DELAY_MAX_MS)}ms`);
      return card;
    };

    const renderEmpty = () => {
      const box = document.createElement("div");
      box.className = "empty-state";
      const title = document.createElement("p");
      title.className = "empty-title";
      title.textContent = "Belum ada berita yang cocok";
      const hint = document.createElement("p");
      hint.textContent = "Coba kata kunci lain, atau pilih “Semua perusahaan”.";
      box.append(title, hint);
      return box;
    };

    const apply = async () => {
      const query = input.value.trim();
      const company = select.value;
      const id = ++runId;

      syncUrl(query, company);

      if (!query && !company) {
        setBrowseMode(true);
        status.textContent = "";
        return;
      }

      let entries: SearchEntry[];
      try {
        entries = await loadIndex(indexUrl);
      } catch {
        if (id !== runId) return;
        setBrowseMode(true);
        status.hidden = false;
        status.textContent = "Pencarian belum bisa dipakai saat ini. Coba muat ulang halaman.";
        return;
      }
      if (id !== runId) return;

      const matches = filterEntries(entries, { query, company });
      const fragment = document.createDocumentFragment();
      if (matches.length === 0) {
        fragment.append(renderEmpty());
      } else {
        matches.forEach((entry, position) => {
          const card = renderCard(entry, position);
          if (card) fragment.append(card);
        });
      }
      results.replaceChildren(fragment);
      setBrowseMode(false);
      status.textContent = describe(matches.length, query, company);
    };

    input.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(apply, TYPING_DEBOUNCE_MS);
    });

    select.addEventListener("change", () => {
      window.clearTimeout(debounceTimer);
      apply();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      window.clearTimeout(debounceTimer);
      apply();
    });

    resetButton.addEventListener("click", () => {
      window.clearTimeout(debounceTimer);
      input.value = "";
      select.value = "";
      apply();
      input.focus();
    });

    // Pulihkan pencarian dari tautan yang dibagikan, misalnya /berita?q=claude&perusahaan=Anthropic.
    const params = new URLSearchParams(window.location.search);
    input.value = params.get("q") ?? "";
    select.value = params.get("perusahaan") ?? "";
    if (input.value.trim() || select.value) apply();
  }

  document.addEventListener("astro:page-load", initNewsSearch);
</script>

<style>
  .archive-header {
    margin-bottom: 2rem;
  }

  /* Atribut hidden harus menang atas display: grid/flex bawaan. */
  [data-browse][hidden],
  [data-search-results][hidden],
  .news-toolbar[hidden],
  .search-status[hidden],
  .toolbar-btn[hidden] {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .news-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-search {
    flex: 1 1 280px;
  }

  .field-company {
    flex: 0 1 240px;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 46px;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(18, 24, 32, 0.75);
    color: var(--text);
    /* 16px mencegah zoom otomatis di iOS saat kolom difokus. */
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 160ms var(--ease-out),
      background 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }

  .field input {
    padding-left: 2.75rem;
  }

  .field select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
    text-overflow: ellipsis;
  }

  .field select option {
    background: var(--bg-elevated);
    color: var(--text);
  }

  .field input::placeholder {
    color: var(--text-muted);
    opacity: 0.85;
  }

  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: rgba(61, 255, 154, 0.55);
    background: var(--bg-elevated);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .field input:focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .field input:hover:not(:focus),
    .field select:hover:not(:focus) {
      border-color: rgba(61, 255, 154, 0.35);
    }
  }

  .field-icon,
  .field-caret {
    position: absolute;
    pointer-events: none;
    color: var(--text-muted);
  }

  .field-icon {
    left: 1rem;
  }

  .field-caret {
    right: 1rem;
  }

  .toolbar-btn {
    min-height: 46px;
    padding-block: 0;
    cursor: pointer;
  }

  .search-status {
    margin: 0 0 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .field-search,
    .field-company {
      flex: 1 1 100%;
    }

    .toolbar-btn {
      flex: 1 1 0;
    }
  }

  /* Tighter gap between lead and meta row (replaces old negative margin) */
  .archive-header .page-lead {
    margin-bottom: calc(var(--space-6) - 1rem);
  }

  .archive-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .count-tag {
    color: var(--text-muted);
  }

  .page-indicator {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(61, 255, 154, 0.25);
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* Pagination styles with Emil Kowalski polish */
  .pagination {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(18, 24, 32, 0.75);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    min-height: 42px;
    transition:
      transform 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      background 160ms var(--ease-out),
      color 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .page-btn:hover:not(.page-disabled) {
      border-color: rgba(61, 255, 154, 0.45);
      background: var(--accent-soft);
      color: var(--accent-bright);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
      text-decoration: none;
    }
  }

  .page-btn:active:not(.page-disabled) {
    transform: scale(0.96) translateY(0);
    transition-duration: 90ms;
  }

  .page-disabled {
    opacity: 0.35;
    cursor: not-allowed;
    background: transparent;
    border-color: rgba(36, 48, 65, 0.5);
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
    border: 1px solid transparent;
    transition:
      transform 160ms var(--ease-out),
      background 160ms var(--ease-out),
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .page-num:hover:not(.active) {
      color: var(--text);
      background: var(--bg-card-hover);
      border-color: var(--border);
      transform: translateY(-1px);
      text-decoration: none;
    }
  }

  .page-num:active:not(.active) {
    transform: scale(0.92);
    transition-duration: 90ms;
  }

  .page-num.active {
    color: #04140c;
    background: var(--accent);
    font-weight: 700;
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .page-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    user-select: none;
  }

  @media (max-width: 600px) {
    .pagination {
      justify-content: center;
      gap: 0.75rem;
    }

    .archive-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
