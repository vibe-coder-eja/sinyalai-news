---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatDate, getPublishedNews, toIsoDate } from "../../../lib/news";
import { withBase } from "../../../lib/url";

export async function getStaticPaths() {
  const articles = await getPublishedNews();
  return articles.map((article) => {
    const parts = article.id.split("/");
    const date = parts.length > 1 ? parts[0] : toIsoDate(article.data.publishedAt);
    const slug = parts.length > 1 ? parts.slice(1).join("/") : parts[0];
    return {
      params: { date, slug },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, summary, company, source, author, publishedAt, updatedAt } = article.data;
const siteUrl = Astro.site || new URL("https://sinyalai.xyz");
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const modifiedAt = updatedAt ?? publishedAt;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": summary,
  "image": [new URL(withBase("/og-default.png"), siteUrl).toString()],
  "datePublished": publishedAt.toISOString(),
  "dateModified": modifiedAt.toISOString(),
  "inLanguage": "id-ID",
  "about": company,
  "isBasedOn": source,
  "author": {
    "@type": "Person",
    "name": author || "Redaktur Sinyal AI News (RSAIN)",
    "url": siteUrl.toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "Sinyal AI",
    "logo": {
      "@type": "ImageObject",
      "url": new URL(withBase("/logo.png"), siteUrl).toString(),
      "width": 512,
      "height": 512
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
};
---

<BaseLayout title={title} description={summary} articleDate={publishedAt.toISOString()} articleCompany={company}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="container article reveal reveal-1">
    <header class="article-header">
      <p class="eyebrow">Detail sinyal</p>
      <div class="meta">
        <span class="tag">{company}</span>
        <span class="author-tag">Oleh: {author || "Redaktur Sinyal AI News (RSAIN)"}</span>
        <time datetime={toIsoDate(publishedAt)}>{formatDate(publishedAt)}</time>
      </div>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead summary">{summary}</p>
    </header>

    <div class="prose article-body">
      <Content />
    </div>

    <div class="source-box">
      <p class="label">Sumber resmi</p>
      <a href={source} target="_blank" rel="noopener noreferrer">
        {source}
      </a>
    </div>

    <a class="back-link" href={withBase("/berita")}>← Kembali ke daftar berita</a>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: min(100% - 2rem, 720px);
  }

  .article-header {
    margin-bottom: 0.25rem;
  }

  .article-header .meta {
    margin-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .author-tag {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .summary {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .article-body {
    max-width: none;
  }
</style>
