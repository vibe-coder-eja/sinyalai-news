---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getPublishedNews } from "../../lib/news";

const articles = await getPublishedNews();
const countLabel =
  articles.length === 0
    ? "Belum ada entri"
    : `${articles.length} sinyal dipublikasikan`;
---

<BaseLayout
  title="Berita"
  description="Daftar berita AI ringkas dari rilis industri — Sinyal AI."
>
  <section class="container reveal reveal-1">
    <p class="eyebrow">Archive</p>
    <h1 class="page-title">Semua berita</h1>
    <p class="page-lead">
      Kumpulan sinyal yang dirangkum dari blog, changelog, dan rilis resmi
      perusahaan AI. Disimpan sebagai Markdown content collections.
    </p>
    <p class="count muted">{countLabel}</p>

    {
      articles.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">Feed masih kosong</p>
          <p>
            Buat file baru di <code>src/content/news/</code> dengan frontmatter
            yang valid.
          </p>
        </div>
      ) : (
        <div class="news-grid">
          {articles.map((article, idx) => (
            <NewsCard article={article} index={idx} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .count {
    margin: -1rem 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
</style>
