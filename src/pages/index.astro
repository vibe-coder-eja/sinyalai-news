---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";
import { getPublishedNews } from "../lib/news";
import { withBase } from "../lib/url";

const articles = await getPublishedNews();
const latest = articles.slice(0, 3);
---

<BaseLayout
  title="Sinyal AI News"
  description="Berita AI berbahasa Indonesia dari sumber resminya. Rilis model, produk, dan kerja sama industri AI dunia, ditulis ringkas dan netral dengan tautan ke sumber asli. Terbit pagi dan malam."
>
  <section class="container hero reveal reveal-1">
    <p class="eyebrow">Berita AI berbahasa Indonesia</p>
    <h1 class="page-title">Kabar terbaru dunia AI, langsung dari sumber resminya</h1>
    <p class="page-lead">
      <strong>Sinyal AI News</strong> menyaring rilis resmi dari perusahaan dan organisasi AI dunia,
      lalu menuliskannya kembali dalam bahasa Indonesia yang ringkas dan netral. Setiap berita memuat
      tautan ke sumber aslinya. Terbit dua kali sehari: edisi pagi pukul 10.35 dan edisi malam
      pukul 22.05 WIB.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href={withBase("/berita")}>Lihat semua berita</a>
      <a class="btn btn-ghost" href={withBase("/tentang")}>Tentang Sinyal AI News</a>
    </div>
  </section>

  <section class="container latest reveal reveal-2">
    <div class="section-head">
      <h2>Berita terbaru</h2>
      <a href={withBase("/berita")}>Semua berita →</a>
    </div>

    {
      latest.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">Belum ada berita</p>
          <p>Tambahkan artikel Markdown di <code>src/content/news/</code>.</p>
        </div>
      ) : (
        <div class="news-grid">
          {latest.map((article, idx) => (
            <NewsCard article={article} index={idx} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-bottom: 2.75rem;
    position: relative;
  }

  .hero::after {
    content: "";
    display: block;
    margin-top: 2.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(61, 255, 154, 0.35),
      var(--border),
      transparent
    );
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .latest {
    padding-top: 0.25rem;
  }

  strong {
    color: var(--text);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
</style>
