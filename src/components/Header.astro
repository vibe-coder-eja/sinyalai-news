---
import { withBase } from "../lib/url";

const pathname = Astro.url.pathname;
const homeHref = withBase("/");

const links = [
  { href: homeHref, label: "Beranda" },
  { href: withBase("/berita"), label: "Berita" },
  { href: withBase("/tentang"), label: "Tentang" },
];

function isActive(href: string): boolean {
  if (href === homeHref) return pathname === homeHref || pathname === `${homeHref}/`;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="Sinyal AI — beranda">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">Sinyal AI</span>
        <span class="brand-tagline">Sinyal Akal Imitasi</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(1.2);
    background: rgba(7, 9, 12, 0.82);
    border-bottom: 1px solid rgba(36, 48, 65, 0.9);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    transition: transform 160ms var(--ease-out);
    will-change: transform;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand:active {
    transform: scale(0.98);
    transition-duration: 90ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark {
      box-shadow: 0 0 24px rgba(61, 255, 154, 0.45);
      transform: translateY(-1px) scale(1.03);
    }
  }

  .brand-mark {
    flex-shrink: 0;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 0.58rem;
    background:
      radial-gradient(circle at 30% 30%, #9dffc9, transparent 45%),
      linear-gradient(145deg, #1a9f5c, #0a0c0f 70%);
    border: 1px solid rgba(61, 255, 154, 0.45);
    box-shadow: 0 0 18px rgba(61, 255, 154, 0.25);
    position: relative;
    transition: box-shadow 200ms var(--ease-out), transform 200ms var(--ease-out);
    will-change: transform, box-shadow;
  }

  .brand-mark::after {
    content: "";
    position: absolute;
    inset: 35% 18% auto;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }

  .brand-name {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
  }

  .brand-tagline {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.52rem 0.95rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 550;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      color 160ms var(--ease-out),
      background 160ms var(--ease-out),
      transform 160ms var(--ease-out);
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--text);
      background: var(--bg-elevated);
      text-decoration: none;
      transform: translateY(-1px);
    }
  }

  .nav-link:active {
    transform: scale(0.95);
    transition-duration: 90ms;
  }

  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .brand-tagline {
      display: none;
    }

    .nav {
      gap: 0.2rem;
    }

    .nav-link {
      padding: 0.45rem 0.72rem;
      font-size: 0.85rem;
      min-height: 36px;
    }
  }
</style>
